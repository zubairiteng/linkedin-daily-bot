# ==============================================================================
# LinkedIn Daily Bot Configuration Template
# Copy this file to .env and fill in your real credentials.
# NEVER commit your real .env or token.json file to version control!
# ==============================================================================

# 1. LinkedIn API (OAuth 2.0)
# Create your app at https://www.linkedin.com/developers/apps
# Products needed: "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect"
# Scopes needed: w_member_social, openid, profile
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback
LINKEDIN_TOKEN_FILE=token.json

# 2. LLM Provider (gemini default / anthropic / openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Anthropic Claude:
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional OpenAI:
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 3. News Source Configuration
NEWS_SOURCE=rss
NEWS_API_KEY=
GNEWS_API_KEY=

# 4. Mode and Safety Controls
AUTO_POST=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_TIMEOUT_SECONDS=7200

# 5. Local Database & Logging
DATABASE_PATH=posted.db
LOG_FILE=bot.log
LOG_LEVEL=INFO
